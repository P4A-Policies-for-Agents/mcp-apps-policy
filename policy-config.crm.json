{
  "appifyTools": true,
  "appifyResponses": true,
  "appifyActions": true,

  "renderer": "auto",

  "csp": {
    "connectDomains": [],
    "resourceDomains": [],
    "frameDomains": [],
    "baseUriDomains": []
  },

  "tools": [
    {
      "name": "get_accounts",
      "renderer": "table",
      "actions": [
        {
          "tool": "update_accounts",
          "label": "Edit",
          "select": "multi",
          "mode": "form",
          "prompt": "Please update the following accounts:\n${edits}\nConfirm with me first."
        },
        {
          "tool": "delete_accounts",
          "label": "Delete",
          "select": "multi",
          "mode": "prompt",
          "prompt": "Please delete the following accounts: ${rows[].Name} (Ids: ${rows[].Id}). Confirm with me first."
        }
      ]
    },
    {
      "name": "create_Accounts",
      "renderer": "form",
      "formFields": [
        {
          "name": "Description",
          "label": "Description",
          "type": "string",
          "placeholder": "Optional account description"
        },
        {
          "name": "Industry",
          "label": "Industry",
          "type": "string",
          "placeholder": "Optional"
        }
      ]
    },
    { "name": "update_accounts", "renderer": "form" },
    { "name": "delete_accounts", "renderer": "card" }
  ],

  "defaultActions": [],
  "denyTools": [],
  "formTools": ["create_Accounts"],
  "customBundles": [],

  "previewMode": false,
  "debugHeaders": false,
  "maxBodyBytes": 1048576
}
