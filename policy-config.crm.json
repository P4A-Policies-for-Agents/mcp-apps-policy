{
  "appifyTools": true,
  "appifyResponses": true,
  "appifyActions": true,

  "renderer": "auto",

  "csp": {
    "connectDomains": [],
    "resourceDomains": [],
    "frameDomains": [],
    "baseUriDomains": []
  },

  "tools": [
    {
      "name": "get_accounts",
      "renderer": "table",
      "actions": [
        {
          "tool": "update_accounts",
          "label": "Edit",
          "select": "single",
          "mode": "form",
          "argsTemplate": "{\"accounts\":[\"${row}\"]}"
        },
        {
          "tool": "delete_accounts",
          "label": "Delete",
          "select": "multi",
          "argsTemplate": "{\"Ids\":\"${rows[].Id}\"}"
        }
      ]
    },
    { "name": "create_Accounts", "renderer": "form" },
    { "name": "update_accounts", "renderer": "form" },
    { "name": "delete_accounts", "renderer": "card" }
  ],

  "defaultActions": [],
  "denyTools": [],
  "customBundles": [],

  "previewMode": true,
  "debugHeaders": true,
  "maxBodyBytes": 1048576
}
