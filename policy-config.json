{
  "appifyTools": true,
  "appifyResponses": true,
  "appifyActions": true,

  "renderer": "auto",

  "tools": [
    {
      "name": "get_inventory",
      "renderer": "card",
      "actions": [
        {
          "tool": "create_order",
          "label": "Order",
          "argsTemplate": "{\"sku\":\"${sku}\"}"
        }
      ]
    },
    {
      "name": "list_customers",
      "renderer": "table",
      "actions": [
        {
          "tool": "get_customer",
          "label": "Open",
          "argsTemplate": "{\"id\":\"${id}\"}"
        }
      ]
    },
    {
      "name": "create_order",
      "renderer": "form"
    }
  ],

  "defaultActions": [],

  "denyTools": ["secret_admin"],

  "customBundles": [],

  "previewMode": false,
  "debugHeaders": false,
  "maxBodyBytes": 1048576
}
