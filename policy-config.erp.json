{
  "appifyTools": true,
  "appifyResponses": true,
  "appifyActions": true,

  "renderer": "auto",

  "csp": {
    "connectDomains": [],
    "resourceDomains": [],
    "frameDomains": [],
    "baseUriDomains": []
  },

  "tools": [
    {
      "name": "get_inventory",
      "renderer": "card",
      "actions": [
        {
          "tool": "submit_order",
          "label": "Order this material",
          "mode": "prompt",
          "prompt": "Please order material ${productId} with quantity 1."
        }
      ]
    },
    {
      "name": "submit_order",
      "renderer": "card",
      "actions": [
        {
          "tool": "submit_delivery",
          "label": "Create delivery",
          "mode": "prompt",
          "prompt": "Please create a delivery for order ${SALESDOCUMENT}."
        }
      ]
    },
    {
      "name": "submit_delivery",
      "renderer": "card"
    }
  ],

  "defaultActions": [],
  "denyTools": [],
  "customBundles": [],

  "previewMode": false,
  "debugHeaders": false,
  "maxBodyBytes": 1048576
}
